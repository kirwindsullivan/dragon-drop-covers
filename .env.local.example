# ─── Clerk (Auth) ─────────────────────────────────────────────────────────────
# Sign up at clerk.com → Create application → API Keys
# Copy both keys here and into your Vercel environment variables.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Clerk redirect URLs (leave as-is — middleware handles these)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/editor
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/editor

# ─── Cloudflare R2 (Session 2) ────────────────────────────────────────────────
# Create a bucket at dash.cloudflare.com → R2 → Create bucket
# Then go to Manage R2 API Tokens → Create API Token (read+write)
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key_here
CLOUDFLARE_R2_BUCKET_NAME=dragon-drop-covers
CLOUDFLARE_R2_PUBLIC_URL=https://your-bucket.your-account.r2.cloudflarestorage.com

# ─── Stripe (Session 3) ───────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── NextAuth (legacy stub — superseded by Clerk) ─────────────────────────────
# NEXTAUTH_SECRET=your_random_secret_here
# NEXTAUTH_URL=http://localhost:3000
